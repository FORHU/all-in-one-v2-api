// ==============================================================================
// COMMERCE: CUSTOMERS, CARTS, ORDERS, PAYMENTS, SHIPMENTS, COUPONS,
//           RETURNS, REFUNDS & TAX ENGINE
// ==============================================================================

enum OrderStatus {
  PENDING
  PROCESSING
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  REFUNDED
  /// Admin declined to fulfill a paid order before placing it with a supplier
  /// (see OrderService.rejectOrder) — distinct from CANCELLED (pre-payment,
  /// no refund involved) and from REFUNDED (set once a Returns-flow refund's
  /// webhook confirms the money moved). rejectOrder issues the refund itself
  /// and sets this status immediately, same "don't wait for the webhook"
  /// tradeoff ReturnService.issueRefund already makes.
  REJECTED
}

enum SupplierOrderStatus {
  PENDING
  PLACED
  CONFIRMED
  SHIPPED
  DELIVERED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PENDING
  PROCESSING
  WAITING_CONFIRMATION
  /// Stripe manual-capture PaymentIntent has authorized (held) the funds but
  /// not yet captured them — set on the `payment_intent.amount_capturable_updated`
  /// webhook. An admin "Accept order" action (OrderService.acceptOrder)
  /// captures it, which flips this to PAID via the existing
  /// `payment_intent.succeeded` handling; "Cancel order" on a still-AUTHORIZED
  /// payment releases the hold instead (PaymentService.cancelAuthorization).
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED
  VOID
  EXPIRED
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum PaymentGateway {
  PAYMONGO
  STRIPE
  PAYPAL
  XENDIT
  MAYA
}

enum PaymentChannel {
  CARD
  EWALLET
  BANK_TRANSFER
  QR
  CASH_ON_DELIVERY
}

enum PaymentInstrument {
  VISA
  MASTERCARD
  AMEX
  GCASH
  MAYA
  BPI
  BDO
  METROBANK
  QRPH
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

/// Full refund/return/replacement request lifecycle — see
/// return-status.util.ts's ALLOWED_RETURN_TRANSITIONS for which moves are
/// legal from which state. Supersedes the old 5-value enum; RECEIVED is
/// dropped in favor of RETURN_PROCESSING (see the migration's backfill).
enum ReturnStatus {
  PENDING
  UNDER_REVIEW
  EVIDENCE_REQUIRED
  APPROVED
  REJECTED
  CJ_DISPUTE_SUBMITTED
  CJ_DISPUTE_UNDER_REVIEW
  CJ_APPROVED
  CJ_REJECTED
  REFUND_PROCESSING
  REPLACEMENT_PROCESSING
  RETURN_PROCESSING
  COMPLETED
  CANCELLED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReturnRequestType {
  REFUND
  REPLACEMENT
  RETURN
}

/// Only meaningful when requestType = RETURN — which outcome the customer
/// wants once the physical item is back with the supplier.
enum ReturnPreferredResolution {
  REFUND
  REPLACEMENT
}

enum ReturnDisputeStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  /// CJ's API call itself failed/was unavailable — see ReturnService.fileCjDispute.
  /// Never set on a real CJ rejection; that's REJECTED.
  FAILED_TO_SUBMIT
}

enum CostCoveredBy {
  CJ
  ADDICTSTYLE
  CUSTOMER_NOT_REFUNDED
  SPLIT
}

enum EvidenceUploaderRole {
  CUSTOMER
  ADMIN
}

model CommerceCustomer {
  id               String   @id @default(uuid())
  tenantId         String
  userId           String
  email            String
  firstName        String?
  lastName         String?
  phone            String?
  stripeCustomerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant     Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       AuthUser                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses  CommerceShippingAddress[]
  carts      CommerceCart[]
  orders     CommerceOrder[]
  reviews    ProductReview[]
  wishlists  Wishlist[]
  returns    Return[]
  statistics AnalyticsCustomer[]

  @@unique([tenantId, userId])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("commerce_customers")
}

model CommerceShippingAddress {
  id           String   @id @default(uuid())
  customerId   String
  fullName     String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String
  country      String
  phone        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer                  CommerceCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders                    CommerceOrder[]
  returnsWithUpdatedAddress Return[]

  @@index([customerId])
  @@map("commerce_shipping_addresses")
}

model CommerceCart {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String?
  sessionId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer CommerceCustomer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CommerceCartItem[]

  @@unique([tenantId, customerId])
  @@unique([tenantId, sessionId])
  @@index([customerId])
  @@index([tenantId])
  @@map("commerce_carts")
}

model CommerceCartItem {
  id               String   @id @default(uuid())
  tenantId         String
  cartId           String
  productVariantId String
  quantity         Int      @default(1)
  unitPrice        Decimal  @db.Decimal(18, 4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cart           CommerceCart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant CatalogProductVariant @relation(fields: [tenantId, productVariantId], references: [tenantId, id], onDelete: Restrict)

  @@unique([cartId, productVariantId])
  @@index([tenantId])
  @@map("commerce_cart_items")
}

model CommerceOrder {
  id       String @id @default(uuid())
  tenantId String

  /// Human-readable reference shown to customers and used in support tickets.
  /// Backed by a Postgres sequence (order_number_seq) so concurrent checkouts
  /// cannot collide — never generate this in application code.
  orderNumber String @default(dbgenerated("('ORD-'::text || lpad((nextval('order_number_seq'::regclass))::text, 8, '0'::text))"))

  status OrderStatus @default(PENDING)

  // Money breakdown. total = subtotal - discount + tax + shipping.
  // Each component is stored rather than derived so a historical order still
  // reproduces exactly what the customer was charged, even after tax rates change.
  subtotal       Decimal @default(0) @db.Decimal(18, 4)
  discountAmount Decimal @default(0) @db.Decimal(18, 4)
  taxAmount      Decimal @default(0) @db.Decimal(18, 4)
  shippingAmount Decimal @default(0) @db.Decimal(18, 4)
  totalAmount    Decimal @db.Decimal(18, 4)

  currency              String   @default("USD")
  customerId            String?
  sessionId             String?
  shippingAddressId     String?
  couponId              String?
  promotionId           String?
  /// Set when this order was created by ReturnResolutionService.createReplacementOrder
  /// as an AddictStyle-funded resend for a refund/replacement request — never set
  /// for a normal checkout order. See CommerceOrder's `replacementOrders` and
  /// Return's `replacementOrder`.
  replacementForOrderId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  /// Set the moment this order's revenue was folded into the analytics rollups.
  /// The rollups are += aggregates with no memory of which orders fed them, so
  /// this is what makes recording exactly-once: the recorder claims the order by
  /// flipping this from NULL in the same transaction, and a duplicate webhook or
  /// a replayed job claims nothing and returns.
  analyticsRecordedAt DateTime?

  tenant               Tenant                   @relation(fields: [tenantId], references: [id])
  customer             CommerceCustomer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shippingAddress      CommerceShippingAddress? @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  coupon               Coupon?                  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  promotion            Promotion?               @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  items                CommerceOrderItem[]
  supplierOrders       CommerceSupplierOrder[] // 1 order -> N supplier fulfillments
  payments             CommercePayment[]
  returns              Return[]
  refunds              Refund[]
  replacementForOrder  CommerceOrder?           @relation("OrderReplacement", fields: [replacementForOrderId], references: [id], onDelete: SetNull)
  replacementOrders    CommerceOrder[]          @relation("OrderReplacement")
  returnReplacementFor Return?                  @relation("ReturnReplacementOrder")

  @@unique([tenantId, id])
  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([shippingAddressId])
  @@index([couponId])
  @@index([promotionId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([replacementForOrderId])
  @@map("commerce_orders")
}

model CommerceOrderItem {
  id               String  @id @default(uuid())
  tenantId         String
  orderId          String
  productVariantId String
  quantity         Int
  unitPrice        Decimal @db.Decimal(18, 4)
  supplierOrderId  String?

  // Immutable historical order snapshot fields
  productTitle String   @default("Unknown Product")
  variantTitle String?
  sku          String?
  imageUrl     String?
  attributes   Json?
  taxRate      Decimal? @db.Decimal(5, 4)
  supplierCost Decimal? @db.Decimal(18, 4)

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order          CommerceOrder          @relation(fields: [orderId], references: [id])
  productVariant CatalogProductVariant  @relation(fields: [tenantId, productVariantId], references: [tenantId, id], onDelete: Restrict)
  supplierOrder  CommerceSupplierOrder? @relation(fields: [supplierOrderId], references: [id], onDelete: SetNull)
  returnItems    ReturnItem[]

  @@index([tenantId])
  @@index([orderId])
  @@index([productVariantId])
  @@index([supplierOrderId])
  @@map("commerce_order_items")
}

model CommerceSupplierOrder {
  id          String              @id @default(uuid())
  orderId     String
  supplierId  String
  externalId  String? // Supplier's order ID after placement
  status      SupplierOrderStatus @default(PENDING)
  rawResponse Json? // Full supplier order response
  trackingNum String?
  placedAt    DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  order     CommerceOrder       @relation(fields: [orderId], references: [id])
  supplier  SupplierPartner     @relation(fields: [supplierId], references: [id])
  shipments CommerceShipment[]
  items     CommerceOrderItem[]

  @@index([orderId])
  @@index([supplierId])
  @@map("commerce_supplier_orders")
}

model CommerceShipment {
  id                String         @id @default(uuid())
  supplierOrderId   String
  trackingNumber    String?
  carrier           String?
  status            ShipmentStatus @default(PENDING)
  shippedAt         DateTime?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  details           Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  supplierOrder CommerceSupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)

  @@index([supplierOrderId])
  @@map("commerce_shipments")
}

model CommercePayment {
  id                   String             @id @default(uuid())
  orderId              String
  gateway              PaymentGateway? // Must be set explicitly by the merchant
  channel              PaymentChannel? // Must be set explicitly by the merchant
  instrument           PaymentInstrument?
  expectedAmount       Decimal            @db.Decimal(18, 4)
  amount               Decimal            @db.Decimal(18, 4)
  currency             String             @default("PHP")
  status               PaymentStatus      @default(CREATED)
  version              Int                @default(1)
  idempotencyKey       String?            @unique
  gatewayTransactionId String?
  gatewayPaymentId     String?
  gatewayResponse      Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  order    CommerceOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attempts CommercePaymentAttempt[]
  events   CommercePaymentEvent[]

  @@index([orderId])
  @@index([status])
  @@index([gateway])
  @@index([createdAt])
  @@index([gatewayTransactionId])
  @@map("commerce_payments")
}

model CommercePaymentAttempt {
  id           String        @id @default(uuid())
  paymentId    String
  amount       Decimal       @db.Decimal(18, 4)
  status       PaymentStatus @default(PENDING)
  errorMessage String?
  rawResponse  Json?
  createdAt    DateTime      @default(now())

  payment CommercePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("commerce_payment_attempts")
}

model CommercePaymentEvent {
  id        String        @id @default(uuid())
  paymentId String
  status    PaymentStatus
  message   String?
  data      Json?
  createdAt DateTime      @default(now())

  payment CommercePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([createdAt])
  @@map("commerce_payment_events")
}

model CommerceWebhookEvent {
  id              String     @id @default(uuid())
  provider        String // e.g. "PAYMONGO", "CJ_DROPSHIPPING"
  /// The provider's own event ID. Gateways retry on any non-2xx response, so this
  /// is what stops a retry from being processed twice. When a provider sends no
  /// event ID, callers pass a SHA-256 of the raw body instead — never a random
  /// value, or the uniqueness below stops meaning anything.
  externalEventId String
  eventType       String
  payload         Json
  status          SyncStatus @default(PENDING)
  errorMessage    String?
  processedAt     DateTime?
  createdAt       DateTime   @default(now())

  @@unique([provider, externalEventId])
  @@index([status, createdAt])
  @@map("commerce_webhook_events")
}

model Coupon {
  id            String       @id @default(uuid())
  tenantId      String
  code          String
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Decimal      @db.Decimal(18, 4)
  minOrderValue Decimal?     @db.Decimal(18, 4)
  maxDiscount   Decimal?     @db.Decimal(18, 4)
  usageLimit    Int?
  usageCount    Int          @default(0)
  expiresAt     DateTime?
  isActive      Boolean      @default(true)
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders CommerceOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@map("coupons")
}

model Return {
  id         String       @id @default(uuid())
  tenantId   String
  orderId    String
  customerId String
  reason     String
  status     ReturnStatus @default(PENDING)
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  requestType              ReturnRequestType          @default(REFUND)
  /// Long-form customer explanation — `reason` stays a short reason code/label
  /// (matches admin's existing RETURN_REASON_OPTIONS), this is the free text.
  description              String?
  preferredResolution      ReturnPreferredResolution?
  updatedShippingAddressId String?
  /// "Don't require physical returns by default" — set true only when CJ's
  /// dispute resolution (or an admin) explicitly requires the item back.
  requiresPhysicalReturn   Boolean                    @default(false)
  /// Set once ReturnResolutionService.createReplacementOrder (Branch B) places
  /// a real, AddictStyle-funded replacement order. Never set for Branch A
  /// (CJ-funded resend) — see return-resolution.service.ts.
  replacementOrderId       String?                    @unique

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    CommerceOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer CommerceCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  refund   Refund?

  items                  ReturnItem[]
  evidence               ReturnEvidence[]
  disputes               ReturnDispute[]
  statusHistory          ReturnStatusHistory[]
  financials             ReturnFinancials?
  physicalShipment       ReturnPhysicalShipment?
  updatedShippingAddress CommerceShippingAddress? @relation(fields: [updatedShippingAddressId], references: [id], onDelete: SetNull)
  replacementOrder       CommerceOrder?           @relation("ReturnReplacementOrder", fields: [replacementOrderId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([orderId])
  @@index([customerId])
  @@index([updatedShippingAddressId])
  @@map("returns")
}

/// Which specific order line item(s) this request covers, and how many units
/// — needed because CJ's dispute API (getDisputeProducts/createDispute) is
/// scoped per line item, and because "prevent duplicate active requests per
/// order item" can't be enforced at the whole-order level. Price/cost are
/// snapshotted at request time, same "immutable historical snapshot"
/// convention CommerceOrderItem itself already uses.
model ReturnItem {
  id                   String   @id @default(uuid())
  tenantId             String
  returnId             String
  orderItemId          String
  quantity             Int
  unitPriceSnapshot    Decimal  @db.Decimal(18, 4)
  supplierCostSnapshot Decimal? @db.Decimal(18, 4)
  createdAt            DateTime @default(now())

  return    Return            @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem CommerceOrderItem @relation(fields: [orderItemId], references: [id])

  @@unique([returnId, orderItemId])
  @@index([tenantId])
  @@index([orderItemId])
  @@map("return_items")
}

/// Customer- or admin-uploaded photo/video attached to a request. Plain-url
/// shape mirrors ReviewImage rather than the polymorphic AuthFile table —
/// same "N photos on a parent record" precedent, simpler for this use case.
model ReturnEvidence {
  id             String               @id @default(uuid())
  returnId       String
  url            String
  mimeType       String?
  uploadedByRole EvidenceUploaderRole @default(CUSTOMER)
  createdAt      DateTime             @default(now())

  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@map("return_evidence")
}

/// One row per CJ dispute filing attempt — a request can be disputed, have it
/// rejected, and be re-filed, which a set of flat columns on Return can't
/// represent without losing history the audit trail needs. The service
/// always treats the latest row (by createdAt) as "the active dispute."
model ReturnDispute {
  id                        String              @id @default(uuid())
  returnId                  String
  /// CJ's own order id for the underlying CommerceSupplierOrder — denormalized
  /// here since a dispute always targets a specific supplier order, not the
  /// whole (possibly multi-supplier-order) CommerceOrder.
  cjOrderExternalId         String
  /// Populated once CJ's response actually confirms one exists — null while
  /// SUBMITTED, or permanently for FAILED_TO_SUBMIT.
  cjDisputeId               String?
  /// Our own idempotency key sent to CJ (max 100 chars per CJ's API).
  businessDisputeId         String
  /// 1 = refund, 2 = reissue/replacement — CJDisputeExpectType.
  expectType                Int
  /// 1 = balance refund (credited to CJ account), 2 = platform refund.
  refundType                Int?
  disputeReasonId           Int?
  status                    ReturnDisputeStatus @default(SUBMITTED)
  /// CJ's raw status string, stored verbatim — unverified against a live
  /// account, so the service never auto-parses this into our own enum. An
  /// admin reads it and calls confirmCjOutcome explicitly.
  cjRawStatus               String?
  cjRefundAmount            Decimal?            @db.Decimal(18, 4)
  cjRawResponse             Json?
  /// Manually transcribed if CJ funds a reissue and surfaces tracking outside
  /// this API (e.g. by email) — see ReturnService's Branch A handling.
  replacementTrackingNumber String?
  replacementCarrier        String?
  submittedAt               DateTime?
  resolvedAt                DateTime?
  /// Admin notes — especially the reason for a FAILED_TO_SUBMIT fallback.
  notes                     String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@map("return_disputes")
}

/// Deliberately separate from both Return (would bloat every list-query row
/// with nullable money columns) and Refund (a narrow "one real Stripe
/// transaction" record also used outside this feature by
/// OrderService.rejectOrder). Keeping customer-refund and CJ-reimbursement
/// accounting as distinct named columns here is the literal expression of
/// "keep these two separate."
model ReturnFinancials {
  id                      String         @id @default(uuid())
  returnId                String         @unique
  tenantId                String
  originalProductCost     Decimal?       @db.Decimal(18, 4)
  customerRefundAmount    Decimal?       @db.Decimal(18, 4)
  cjReimbursementAmount   Decimal?       @db.Decimal(18, 4)
  replacementProductCost  Decimal?       @db.Decimal(18, 4)
  replacementShippingCost Decimal?       @db.Decimal(18, 4)
  costCoveredBy           CostCoveredBy?
  outcomeNotes            String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("return_financials")
}

/// Only created when CJ (or an admin) requires the physical item back before
/// resolving — "don't require physical returns by default" means most
/// requests never get one of these rows at all.
model ReturnPhysicalShipment {
  id                     String    @id @default(uuid())
  returnId               String    @unique
  carrier                String?
  trackingNumber         String?
  instructions           String?
  shippedAt              DateTime?
  receivedAt             DateTime?
  receivedConditionNotes String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@map("return_physical_shipments")
}

/// Audit trail of every status transition — inserted in the same transaction
/// as the status change itself (see return.repository.ts's transitionStatus).
model ReturnStatusHistory {
  id          String        @id @default(uuid())
  returnId    String
  fromStatus  ReturnStatus?
  toStatus    ReturnStatus
  actorUserId String?
  /// Snapshot, not a live join — "CUSTOMER" | "ADMIN" | "SYSTEM".
  actorRole   String?
  note        String?
  createdAt   DateTime      @default(now())

  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@map("return_status_history")
}

model Refund {
  id            String       @id @default(uuid())
  tenantId      String
  orderId       String
  returnId      String?      @unique
  amount        Decimal      @db.Decimal(18, 4)
  reason        String?
  status        RefundStatus @default(PENDING)
  transactionId String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  return Return?       @relation(fields: [returnId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([orderId])
  @@map("refunds")
}

// --- Tax Engine ---

model TaxClass {
  id          String   @id @default(uuid())
  tenantId    String
  name        String // e.g. "Standard Goods", "Reduced VAT", "Digital Services"
  code        String // e.g. "STANDARD", "REDUCED", "ZERO"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rates    TaxRate[]
  products CatalogProduct[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("tax_classes")
}

model TaxRate {
  id         String   @id @default(uuid())
  tenantId   String
  taxClassId String?
  name       String // e.g. "VAT 12%", "California Sales Tax"
  rate       Decimal  @db.Decimal(5, 4) // e.g. 0.1200 for 12%
  country    String // ISO 2-letter country code e.g. "PH", "US"
  state      String? // State / province code e.g. "CA", "NY"
  postalCode String?
  isCombined Boolean  @default(false)
  priority   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxClass TaxClass? @relation(fields: [tenantId, taxClassId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId])
  @@index([taxClassId])
  @@index([tenantId, country, state])
  @@map("tax_rates")
}
