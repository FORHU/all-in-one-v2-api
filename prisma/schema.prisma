generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// 1. USER & AUTHENTICATION SCHEMA
// ==============================================================================

model AuthUser {
  id                  String              @id @default(uuid())
  email               String              @unique
  password            String? // Optional for social-only users
  name                String?
  username            String              @unique
  role                UserRole            @default(USER)
  isActive            Boolean             @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  avatarId            String?
  isDeleted           Boolean             @default(false)
  isEmailVerified     Boolean             @default(true)
  onboardingCompleted Boolean             @default(false)
  avatar              AuthFile?           @relation("UserAvatar", fields: [avatarId], references: [id])
  sessions            AuthSession[]
  socialAccounts      AuthSocialAccount[]
  customer            CommerceCustomer?
  auditLogs           AuditLog[]
  notifications       Notification[]

  @@map("auth_users")
}

model AuthSession {
  id                String   @id @default(uuid())
  userId            String
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  refreshToken      String   @unique
  provider          String?
  providerAvatarUrl String?

  user AuthUser @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("auth_sessions")
}

model AuthSocialAccount {
  id             String    @id @default(uuid())
  userId         String
  platform       String
  providerUserId String
  accessToken    String
  refreshToken   String?
  expiresAt      DateTime?
  scopes         String?
  avatarUrl      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           AuthUser  @relation(fields: [userId], references: [id])

  @@unique([userId, platform])
  @@map("auth_social_accounts")
}

model AuthFile {
  id           String                @id @default(uuid())
  filename     String?
  fileUrl      String?
  mimeType     String? // e.g. "application/pdf", "image/gif", "video/mp4"
  fileSize     Int? // in bytes
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?
  metaData     Json?
  users        AuthUser[]            @relation("UserAvatar")
  productMedia CatalogProductMedia[]
  socialAds    MarketingSocialAd[]

  @@map("auth_files")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
  DEVELOPER
}

// ==============================================================================
// 2. TENANCY & STOREFRONT VERTICALS
// ==============================================================================

/// A storefront vertical — e.g. "fashion", "beauty", "sports". Each one gets
/// its own subdomain, catalog and CMS content, but shares the platform's users,
/// customers and supplier integrations.
model Tenant {
  id        String       @id @default(uuid())
  slug      String       @unique // subdomain: fashion -> fashion.example.com
  name      String
  domain    String?      @unique // optional custom domain
  status    TenantStatus @default(ACTIVE)
  settings  Json? // theme, logo, contact details
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  categories            CatalogCategory[]
  products              CatalogProduct[]
  variants              CatalogProductVariant[]
  pricingRules          CatalogPricingRule[]
  carts                 CommerceCart[]
  orders                CommerceOrder[]
  pages                 CmsPage[]
  banners               CmsBanner[]
  announcements         CmsAnnouncement[]
  faqs                  CmsFAQ[]
  productSocialFeeds    MarketingSocialFeed[]
  productSocialAds      MarketingSocialAd[]
  shareableSocialLinks  MarketingShareableLink[]
  inventoryTransactions InventoryTransaction[]
  notifications         Notification[]
  reviews               ProductReview[]
  wishlists             Wishlist[]
  coupons               Coupon[]
  returns               Return[]
  refunds               Refund[]
  productSalesStats     AnalyticsProductSales[]
  categorySalesStats    AnalyticsCategorySales[]
  supplierStats         AnalyticsSupplier[]
  customerStats         AnalyticsCustomer[]
  dailySalesStats       AnalyticsDailySales[]

  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// ==============================================================================
// 3. CATEGORY & PRODUCT CATALOG SCHEMA
// ==============================================================================

model CatalogCategory {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  description String?
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent     CatalogCategory?         @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children   CatalogCategory[]        @relation("CategoryHierarchy")
  products   CatalogProduct[]
  salesStats AnalyticsCategorySales[]

  @@unique([tenantId, slug])
  @@index([parentId])
  @@index([tenantId])
  @@map("catalog_categories")
}

model CatalogProduct {
  id          String        @id @default(uuid())
  tenantId    String
  title       String
  slug        String?
  description String?
  tags        String[]
  status      ProductStatus @default(DRAFT)
  featured    Boolean       @default(false)
  salePrice   Decimal?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  categoryId String?
  category   CatalogCategory? @relation(fields: [categoryId], references: [id])

  pricingRuleId String?
  pricingRule   CatalogPricingRule? @relation(fields: [pricingRuleId], references: [id])

  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants             CatalogProductVariant[]
  supplierProducts     SupplierProduct[]
  media                CatalogProductMedia[]
  socialAds            MarketingSocialAd[]
  shareableSocialLinks MarketingShareableLink[]
  reviews              ProductReview[]
  salesStats           AnalyticsProductSales[]

  @@unique([tenantId, slug])
  @@index([categoryId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, featured])
  @@index([tenantId, createdAt])
  @@map("catalog_products")
}

enum ProductStatus {
  DRAFT
  READY
  PUBLISHED
  ARCHIVED
}

model CatalogProductVariant {
  id              String   @id @default(uuid())
  tenantId        String
  productId       String
  sku             String?
  title           String
  price           Decimal  @db.Decimal(12, 2) // Legacy / main display price
  baseCost        Decimal? @db.Decimal(12, 2) // Supplier cost
  sellingPrice    Decimal? @db.Decimal(12, 2) // Configured selling price
  calculatedPrice Decimal? @db.Decimal(12, 2) // Price after automated pricing rule markup
  stock           Int      @default(0)
  attributes      Json? // e.g. { color: "red", size: "XL" }

  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product               CatalogProduct          @relation(fields: [productId], references: [id])
  supplierVariants      SupplierVariant[]
  orderItems            CommerceOrderItem[]
  cartItems             CommerceCartItem[]
  media                 CatalogProductMedia[]
  inventoryTransactions InventoryTransaction[]
  wishlistItems         WishlistItem[]
  salesStats            AnalyticsProductSales[]

  @@unique([tenantId, sku])
  @@index([productId])
  @@index([tenantId])
  @@map("catalog_product_variants")
}

model CatalogProductMedia {
  id               String    @id @default(uuid())
  productId        String
  productVariantId String?
  fileId           String?
  url              String
  type             MediaType @default(IMAGE)
  altText          String?
  position         Int       @default(0)
  isPrimary        Boolean   @default(false)
  createdAt        DateTime  @default(now())

  product        CatalogProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant CatalogProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  file           AuthFile?              @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([productVariantId])
  @@index([fileId])
  @@map("catalog_product_media")
}

enum MediaType {
  IMAGE
  GIF
  VIDEO
  AUDIO
  DOCUMENT
  ARCHIVE
  OTHER
}

// ==============================================================================
// 4. MULTI-SUPPLIER DROPSHIPPING SCHEMA
// ==============================================================================

model SupplierPartner {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. "cj-dropshipping", "aliexpress", "zendrop"
  displayName String
  isActive    Boolean  @default(true)
  config      Json? // API keys, base URLs, rate limits
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  credentials SupplierCredential[]
  products    SupplierProduct[]
  orders      CommerceSupplierOrder[]
  syncLogs    SupplierSyncLog[]
  statistics  AnalyticsSupplier[]

  @@map("supplier_partners")
}

model SupplierCredential {
  id          String    @id @default(uuid())
  supplierId  String
  environment String    @default("production") // e.g. "sandbox", "production"
  apiKey      String?
  apiSecret   String?
  accessToken String?
  expiresAt   DateTime?
  config      Json?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  supplier SupplierPartner @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_credentials")
}

model SupplierSyncLog {
  id               String     @id @default(uuid())
  supplierId       String
  action           String // e.g. "SYNC_PRODUCTS", "SYNC_ORDERS"
  status           SyncStatus @default(PENDING)
  recordsProcessed Int        @default(0)
  details          Json?
  errorMessage     String?
  startedAt        DateTime   @default(now())
  completedAt      DateTime?

  supplier SupplierPartner @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_sync_logs")
}

model SupplierProduct {
  id               String     @id @default(uuid())
  supplierId       String
  productId        String? // null = not yet mapped to catalog
  externalId       String // Supplier's own product ID
  externalSku      String?
  rawData          Json // Full supplier response
  costPrice        Decimal
  shippingEstimate Decimal?
  syncStatus       SyncStatus @default(PENDING)
  lastSyncError    String?
  lastSyncedAt     DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  supplier SupplierPartner   @relation(fields: [supplierId], references: [id])
  product  CatalogProduct?   @relation(fields: [productId], references: [id])
  variants SupplierVariant[]

  @@unique([supplierId, externalId])
  @@index([supplierId])
  @@index([productId])
  @@map("supplier_products")
}

model SupplierVariant {
  id                String     @id @default(uuid())
  supplierProductId String
  productVariantId  String? // null = not yet mapped
  externalId        String
  costPrice         Decimal
  rawData           Json
  stock             Int?
  syncStatus        SyncStatus @default(PENDING)
  lastSyncError     String?
  lastSyncedAt      DateTime?

  supplierProduct SupplierProduct        @relation(fields: [supplierProductId], references: [id])
  productVariant  CatalogProductVariant? @relation(fields: [productVariantId], references: [id])

  @@unique([supplierProductId, externalId])
  @@map("supplier_variants")
}

// ==============================================================================
// 5. COMMERCE: CUSTOMERS, CARTS & SHIPPING
// ==============================================================================

model CommerceCustomer {
  id        String   @id @default(uuid())
  userId    String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       AuthUser                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses  CommerceShippingAddress[]
  carts      CommerceCart[]
  orders     CommerceOrder[]
  reviews    ProductReview[]
  wishlists  Wishlist[]
  returns    Return[]
  statistics AnalyticsCustomer[]

  @@map("commerce_customers")
}

model CommerceShippingAddress {
  id           String   @id @default(uuid())
  customerId   String
  fullName     String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String
  country      String
  phone        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer CommerceCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders   CommerceOrder[]

  @@index([customerId])
  @@map("commerce_shipping_addresses")
}

model CommerceCart {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String?
  sessionId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer CommerceCustomer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CommerceCartItem[]

  @@unique([tenantId, customerId])
  @@unique([tenantId, sessionId])
  @@index([customerId])
  @@index([tenantId])
  @@map("commerce_carts")
}

model CommerceCartItem {
  id               String   @id @default(uuid())
  cartId           String
  productVariantId String
  quantity         Int      @default(1)
  unitPrice        Decimal
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cart           CommerceCart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant CatalogProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([cartId, productVariantId])
  @@map("commerce_cart_items")
}

// ==============================================================================
// 6. COMMERCE: ORDERS, PAYMENTS & FULFILLMENT
// ==============================================================================

model CommerceOrder {
  id                String      @id @default(uuid())
  tenantId          String
  status            OrderStatus @default(PENDING)
  totalAmount       Decimal     @db.Decimal(12, 2)
  currency          String      @default("USD")
  customerId        String?
  sessionId         String?
  shippingAddressId String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  customer        CommerceCustomer?        @relation(fields: [customerId], references: [id])
  shippingAddress CommerceShippingAddress? @relation(fields: [shippingAddressId], references: [id])
  items           CommerceOrderItem[]
  supplierOrders  CommerceSupplierOrder[] // 1 order -> N supplier fulfillments
  payments        CommercePayment[]
  returns         Return[]
  refunds         Refund[]

  @@index([tenantId])
  @@index([customerId])
  @@index([shippingAddressId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("commerce_orders")
}

model CommerceOrderItem {
  id               String  @id @default(uuid())
  orderId          String
  productVariantId String
  quantity         Int
  unitPrice        Decimal
  supplierOrderId  String?

  order          CommerceOrder          @relation(fields: [orderId], references: [id])
  productVariant CatalogProductVariant  @relation(fields: [productVariantId], references: [id])
  supplierOrder  CommerceSupplierOrder? @relation(fields: [supplierOrderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productVariantId])
  @@index([supplierOrderId])
  @@map("commerce_order_items")
}

model CommerceSupplierOrder {
  id          String              @id @default(uuid())
  orderId     String
  supplierId  String
  externalId  String? // Supplier's order ID after placement
  status      SupplierOrderStatus @default(PENDING)
  rawResponse Json? // Full supplier order response
  trackingNum String?
  placedAt    DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  order     CommerceOrder       @relation(fields: [orderId], references: [id])
  supplier  SupplierPartner     @relation(fields: [supplierId], references: [id])
  shipments CommerceShipment[]
  items     CommerceOrderItem[]

  @@index([orderId])
  @@index([supplierId])
  @@map("commerce_supplier_orders")
}

model CommerceShipment {
  id                String         @id @default(uuid())
  supplierOrderId   String
  trackingNumber    String?
  carrier           String?
  status            ShipmentStatus @default(PENDING)
  shippedAt         DateTime?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  details           Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  supplierOrder CommerceSupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)

  @@index([supplierOrderId])
  @@map("commerce_shipments")
}

model CommercePayment {
  id                   String             @id @default(uuid())
  orderId              String
  gateway              PaymentGateway     @default(PAYMONGO)
  channel              PaymentChannel     @default(CARD)
  instrument           PaymentInstrument?
  expectedAmount       Decimal            @db.Decimal(18, 2)
  amount               Decimal            @db.Decimal(18, 2)
  currency             String             @default("PHP")
  status               PaymentStatus      @default(CREATED)
  version              Int                @default(1)
  idempotencyKey       String?            @unique
  gatewayTransactionId String?
  gatewayPaymentId     String?
  gatewayResponse      Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  order    CommerceOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attempts CommercePaymentAttempt[]
  events   CommercePaymentEvent[]

  @@index([orderId])
  @@index([status])
  @@index([gateway])
  @@index([createdAt])
  @@index([gatewayTransactionId])
  @@map("commerce_payments")
}

model CommercePaymentEvent {
  id        String        @id @default(uuid())
  paymentId String
  status    PaymentStatus
  message   String?
  data      Json?
  createdAt DateTime      @default(now())

  payment CommercePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([createdAt])
  @@map("commerce_payment_events")
}

model CommerceWebhookEvent {
  id           String     @id @default(uuid())
  provider     String // e.g. "PAYMONGO", "CJ_DROPSHIPPING"
  eventType    String
  payload      Json
  status       SyncStatus @default(PENDING)
  errorMessage String?
  processedAt  DateTime?
  createdAt    DateTime   @default(now())

  @@map("commerce_webhook_events")
}

enum OrderStatus {
  PENDING
  PROCESSING
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  REFUNDED
}

enum SupplierOrderStatus {
  PENDING
  PLACED
  CONFIRMED
  SHIPPED
  DELIVERED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PENDING
  PROCESSING
  WAITING_CONFIRMATION
  PAID
  FAILED
  CANCELLED
  REFUNDED
  VOID
  EXPIRED
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

// ==============================================================================
// 7. BACKGROUND JOBS & OPERATIONAL AUDITING
// ==============================================================================

model Job {
  id          String    @id @default(uuid())
  type        String // e.g., 'PRODUCT_SYNC'
  content     String? // A friendly name/description
  status      JobStatus @default(PENDING)
  payload     Json? // Input parameters & progress tracking
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  logs JobLog[]

  @@map("jobs")
}

model JobLog {
  id        String   @id @default(uuid())
  jobId     String
  level     LogLevel @default(INFO)
  message   String
  details   Json?
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String // e.g. "UPDATE_PRICING_RULE", "DELETE_PRODUCT"
  entity    String // e.g. "Product", "User"
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user AuthUser? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("audit_logs")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PAUSED
  CANCELLED
}

enum LogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

// ==============================================================================
// 8. CENTRALIZED MARKETPLACE & PRICING RULES
// ==============================================================================

model CatalogPricingRule {
  id            String     @id @default(uuid())
  tenantId      String
  name          String
  markupType    MarkupType
  markupValue   Decimal
  minimumProfit Decimal?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products CatalogProduct[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("catalog_pricing_rules")
}

enum MarkupType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum SyncStatus {
  PENDING
  SUCCESS
  FAILED
}

// ==============================================================================
// 9. CMS (CONTENT MANAGEMENT SYSTEM) MODELS
// ==============================================================================

model CmsPage {
  id          String     @id @default(uuid())
  tenantId    String
  slug        String
  title       String
  status      PageStatus @default(DRAFT)
  seoMetadata Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sections CmsPageSection[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("cms_pages")
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model CmsPageSection {
  id        String   @id @default(uuid())
  pageId    String
  type      String // e.g. "HERO", "FEATURE_GRID", "TESTIMONIALS"
  content   Json
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page CmsPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("cms_page_sections")
}

model CmsBanner {
  id        String   @id @default(uuid())
  tenantId  String
  title     String
  imageUrl  String
  linkUrl   String?
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("cms_banners")
}

model CmsAnnouncement {
  id        String   @id @default(uuid())
  tenantId  String
  content   String
  linkUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("cms_announcements")
}

model CmsFAQ {
  id        String   @id @default(uuid())
  tenantId  String
  question  String
  answer    String
  category  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("cms_faqs")
}

// ==============================================================================
// 10. MARKETING & AD DISTRIBUTION SCHEMA
// ==============================================================================

model MarketingSocialFeed {
  id           String           @id @default(uuid())
  tenantId     String
  name         String // e.g. "Google Merchant Feed", "Meta Catalog"
  platform     AdSocialPlatform @default(META)
  feedUrl      String? // Public XML / JSON feed endpoint
  isActive     Boolean          @default(true)
  config       Json? // Category mapping, pricing overrides
  lastSyncedAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("marketing_social_feeds")
}

model MarketingSocialAd {
  id               String           @id @default(uuid())
  tenantId         String
  productId        String
  mediaFileId      String? // Video creative or image banner file
  mediaUrl         String? // Direct URL or fallback for ad creative
  title            String
  headline         String?
  description      String?
  platform         AdSocialPlatform @default(META)
  externalAdId     String? // Ad ID on Meta Ads / Google Ads API
  status           AdSocialStatus   @default(DRAFT)
  adUrl            String? // Target URL with UTM params
  dailyBudget      Decimal?         @db.Decimal(12, 2)
  totalSpend       Decimal?         @default(0) @db.Decimal(12, 2)
  clicksCount      Int              @default(0)
  conversionsCount Int              @default(0)
  revenueGenerated Decimal?         @default(0) @db.Decimal(18, 2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaFile AuthFile?      @relation(fields: [mediaFileId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([productId])
  @@index([mediaFileId])
  @@map("marketing_social_ads")
}

model MarketingShareableLink {
  id          String   @id @default(uuid())
  tenantId    String
  productId   String
  code        String   @unique // Short tracking code e.g. "x89f2a"
  utmSource   String? // e.g. "facebook", "tiktok", "instagram"
  utmMedium   String? // e.g. "ad", "influencer", "story"
  utmCampaign String? // e.g. "summer_sale"
  clicks      Int      @default(0)
  conversions Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@map("marketing_shareable_links")
}

enum AdSocialPlatform {
  META
  GOOGLE
  TIKTOK
  PINTEREST
  CUSTOM
}

enum AdSocialStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

// ==============================================================================
// 11. INVENTORY, REVIEWS & CUSTOMER ENGAGEMENT
// ==============================================================================

model InventoryTransaction {
  id               String                   @id @default(uuid())
  tenantId         String
  productVariantId String
  type             InventoryTransactionType
  quantity         Int // Positive (restock/return) or negative (sale)
  previousStock    Int
  newStock         Int
  referenceId      String? // e.g. orderId or supplierSyncLogId
  notes            String?
  createdAt        DateTime                 @default(now())

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productVariant CatalogProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productVariantId])
  @@map("inventory_transactions")
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  RETURN
  SUPPLIER_SYNC
  MANUAL_ADJUSTMENT
}

model Notification {
  id        String           @id @default(uuid())
  tenantId  String
  userId    String
  type      NotificationType @default(SYSTEM_ALERT)
  title     String
  message   String
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("notifications")
}

enum NotificationType {
  ORDER_STATUS
  PAYMENT_CONFIRMED
  SHIPMENT_TRACKING
  SYSTEM_ALERT
  PROMOTION
}

model ProductReview {
  id            String   @id @default(uuid())
  tenantId      String
  productId     String
  customerId    String
  rating        Int
  title         String?
  comment       String?
  isVerified    Boolean  @default(false)
  merchantReply String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  CatalogProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer CommerceCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  images   ReviewImage[]

  @@index([tenantId])
  @@index([productId])
  @@index([customerId])
  @@map("product_reviews")
}

model ReviewImage {
  id        String   @id @default(uuid())
  reviewId  String
  url       String
  createdAt DateTime @default(now())

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_images")
}

model Wishlist {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer CommerceCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    WishlistItem[]

  @@unique([tenantId, customerId])
  @@index([tenantId])
  @@index([customerId])
  @@map("wishlists")
}

model WishlistItem {
  id               String   @id @default(uuid())
  wishlistId       String
  productVariantId String
  createdAt        DateTime @default(now())

  wishlist       Wishlist              @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productVariant CatalogProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productVariantId])
  @@map("wishlist_items")
}

model Coupon {
  id            String       @id @default(uuid())
  tenantId      String
  code          String
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Decimal      @db.Decimal(12, 2)
  minOrderValue Decimal?     @db.Decimal(12, 2)
  maxDiscount   Decimal?     @db.Decimal(12, 2)
  usageLimit    Int?
  usageCount    Int          @default(0)
  expiresAt     DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("coupons")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model Return {
  id         String       @id @default(uuid())
  tenantId   String
  orderId    String
  customerId String
  reason     String
  status     ReturnStatus @default(PENDING)
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    CommerceOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer CommerceCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  refund   Refund?

  @@index([tenantId])
  @@index([orderId])
  @@index([customerId])
  @@map("returns")
}

model Refund {
  id            String       @id @default(uuid())
  tenantId      String
  orderId       String
  returnId      String?      @unique
  amount        Decimal      @db.Decimal(12, 2)
  reason        String?
  status        RefundStatus @default(PENDING)
  transactionId String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  return Return?       @relation(fields: [returnId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([orderId])
  @@map("refunds")
}

model CommercePaymentAttempt {
  id           String        @id @default(uuid())
  paymentId    String
  amount       Decimal       @db.Decimal(12, 2)
  status       PaymentStatus @default(PENDING)
  errorMessage String?
  rawResponse  Json?
  createdAt    DateTime      @default(now())

  payment CommercePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("commerce_payment_attempts")
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentGateway {
  PAYMONGO
  STRIPE
  PAYPAL
  XENDIT
  MAYA
}

enum PaymentChannel {
  CARD
  EWALLET
  BANK_TRANSFER
  QR
  CASH_ON_DELIVERY
}

enum PaymentInstrument {
  VISA
  MASTERCARD
  AMEX
  GCASH
  MAYA
  BPI
  BDO
  METROBANK
  QRPH
}

// ==============================================================================
// 12. ENTERPRISE ADMIN DASHBOARD ANALYTICS
// ==============================================================================

model AnalyticsProductSales {
  id               String    @id @default(uuid())
  tenantId         String
  productId        String
  productVariantId String?
  totalSold        Int       @default(0)
  totalRevenue     Decimal   @default(0) @db.Decimal(18, 2)
  totalOrders      Int       @default(0)
  lastSoldAt       DateTime?
  updatedAt        DateTime  @updatedAt

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product        CatalogProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant CatalogProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@unique([tenantId, productVariantId])
  @@index([tenantId])
  @@index([productId])
  @@index([tenantId, totalSold])
  @@map("analytics_product_sales")
}

model AnalyticsCategorySales {
  id                String   @id @default(uuid())
  tenantId          String
  categoryId        String
  totalRevenue      Decimal  @default(0) @db.Decimal(18, 2)
  totalOrders       Int      @default(0)
  totalProductsSold Int      @default(0)
  updatedAt         DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([tenantId, categoryId])
  @@index([tenantId])
  @@index([categoryId])
  @@map("analytics_category_sales")
}

model AnalyticsSupplier {
  id               String   @id @default(uuid())
  tenantId         String
  supplierId       String
  productsImported Int      @default(0)
  totalOrders      Int      @default(0)
  totalRevenue     Decimal  @default(0) @db.Decimal(18, 2)
  failedOrders     Int      @default(0)
  avgDeliveryDays  Decimal? @db.Decimal(5, 2)
  updatedAt        DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier SupplierPartner @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([tenantId, supplierId])
  @@index([tenantId])
  @@index([supplierId])
  @@map("analytics_suppliers")
}

model AnalyticsCustomer {
  id            String    @id @default(uuid())
  tenantId      String
  customerId    String
  lifetimeSpend Decimal   @default(0) @db.Decimal(18, 2)
  totalOrders   Int       @default(0)
  avgOrderValue Decimal   @default(0) @db.Decimal(12, 2)
  lastOrderedAt DateTime?
  updatedAt     DateTime  @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer CommerceCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, customerId])
  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, lifetimeSpend])
  @@map("analytics_customers")
}

model AnalyticsDailySales {
  id                   String   @id @default(uuid())
  tenantId             String
  date                 DateTime @db.Date
  ordersCount          Int      @default(0)
  revenueAmount        Decimal  @default(0) @db.Decimal(18, 2)
  bestSellingProductId String?
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId])
  @@index([tenantId, date])
  @@map("analytics_daily_sales")
}
