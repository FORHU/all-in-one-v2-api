generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// 1. USER & AUTHENTICATION SCHEMA
// ==============================================================================

model AuthUser {
  id                  String              @id @default(uuid())
  email               String              @unique
  password            String? // Optional for social-only users
  name                String?
  username            String              @unique
  role                UserRole            @default(USER)
  isActive            Boolean             @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  avatarId            String?
  isDeleted           Boolean             @default(false)
  isEmailVerified     Boolean             @default(true)
  onboardingCompleted Boolean             @default(false)
  avatar              AuthFile?           @relation("UserAvatar", fields: [avatarId], references: [id])
  sessions            AuthSession[]
  socialAccounts      AuthSocialAccount[]
  customer            CommerceCustomer?
  auditLogs           AuditLog[]
  notifications       Notification[]

  @@map("auth_users")
}

model AuthSession {
  id                String   @id @default(uuid())
  userId            String
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  refreshToken      String   @unique
  provider          String?
  providerAvatarUrl String?

  user AuthUser @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("auth_sessions")
}

model AuthSocialAccount {
  id             String    @id @default(uuid())
  userId         String
  platform       String
  providerUserId String
  accessToken    String
  refreshToken   String?
  expiresAt      DateTime?
  scopes         String?
  avatarUrl      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           AuthUser  @relation(fields: [userId], references: [id])

  @@unique([userId, platform])
  @@map("auth_social_accounts")
}

model AuthFile {
  id                    String                  @id @default(uuid())
  filename              String?
  fileUrl               String?
  mimeType              String? // e.g. "application/pdf", "image/gif", "video/mp4"
  fileSize              Int? // in bytes
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  deletedAt             DateTime?
  metaData              Json?
  users                 AuthUser[]              @relation("UserAvatar")
  productMedia          CatalogProductMedia[]
  socialAds             MarketingSocialAd[]
  collections           CatalogCollection[]     @relation("CollectionImageFile")
  collectionItems       CatalogCollectionItem[] @relation("CollectionItemImageFile")
  supplierProductImages SupplierProductImage[]
  supplierVariantImages SupplierVariantImage[]
  cmsBanners            CmsBanner[]             @relation("BannerImageFile")

  @@map("auth_files")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
  DEVELOPER
  SELLER
}

// ==============================================================================
// 2. TENANCY & STOREFRONT VERTICALS
// ==============================================================================

/// A storefront vertical — e.g. "fashion", "beauty", "sports". Each one gets
/// its own subdomain, catalog and CMS content, but shares the platform's users,
/// customers and supplier integrations.
model Tenant {
  id        String       @id @default(uuid())
  slug      String       @unique // subdomain: fashion -> fashion.example.com
  name      String
  domain    String?      @unique // optional custom domain
  status    TenantStatus @default(ACTIVE)
  settings  Json? // theme, logo, contact details
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  categories            CatalogCategory[]
  products              CatalogProduct[]
  variants              CatalogProductVariant[]
  pricingRules          CatalogPricingRule[]
  carts                 CommerceCart[]
  orders                CommerceOrder[]
  pages                 CmsPage[]
  banners               CmsBanner[]
  announcements         CmsAnnouncement[]
  faqs                  CmsFAQ[]
  productSocialFeeds    MarketingSocialFeed[]
  productSocialAds      MarketingSocialAd[]
  shareableSocialLinks  MarketingShareableLink[]
  inventoryTransactions InventoryTransaction[]
  notifications         Notification[]
  reviews               ProductReview[]
  wishlists             Wishlist[]
  coupons               Coupon[]
  returns               Return[]
  refunds               Refund[]
  productSalesStats     AnalyticsProductSales[]
  categorySalesStats    AnalyticsCategorySales[]
  supplierStats         AnalyticsSupplier[]
  customerStats         AnalyticsCustomer[]
  dailySalesStats       AnalyticsDailySales[]
  collections           CatalogCollection[]
  attributes            CatalogAttribute[]
  promotions            Promotion[]
  inventoryLocations    InventoryLocation[]
  inventoryStocks       InventoryStock[]
  taxClasses            TaxClass[]
  taxRates              TaxRate[]
  supplierSyncJobs      SupplierSyncJob[]
  storefrontSections    StorefrontSection[]
  storefrontPages       StorefrontPage[]

  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// ==============================================================================
// 3. CATEGORY & PRODUCT CATALOG SCHEMA
// ==============================================================================

model CatalogCategory {
  id             String    @id @default(uuid())
  tenantId       String
  name           String
  slug           String
  description    String?
  parentId       String?
  sortOrder      Int       @default(0)
  seoTitle       String?
  seoDescription String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent     CatalogCategory?         @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children   CatalogCategory[]        @relation("CategoryHierarchy")
  products   CatalogProduct[]
  salesStats AnalyticsCategorySales[]

  @@unique([tenantId, slug])
  @@index([parentId])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@map("catalog_categories")
}

model CatalogProduct {
  id             String            @id @default(uuid())
  tenantId       String
  title          String
  slug           String // Required for URL routing — auto-generated from title if not provided
  description    String?
  tags           String[]
  status         ProductStatus     @default(DRAFT)
  visibility     ProductVisibility @default(PUBLIC)
  featured       Boolean           @default(false)
  price          Decimal?          @db.Decimal(18, 2) // Main display selling price
  salePrice      Decimal?          @db.Decimal(18, 2) // Active discounted price (if on sale)
  compareAtPrice Decimal?          @db.Decimal(18, 2) // Crossed-out original price (MSRP / "fake" price before discount)
  discount       Json? // Structured discount details: { type: "PERCENTAGE"|"FIXED", value: 20, percentage: 20, savings: 240, badge: "20% OFF", endDate: "..." }
  thumbnailUrl   String? // Quick-access primary image URL
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  categoryId String?
  category   CatalogCategory? @relation(fields: [categoryId], references: [id])

  pricingRuleId String?
  pricingRule   CatalogPricingRule? @relation(fields: [pricingRuleId], references: [id])

  taxClassId String?
  taxClass   TaxClass? @relation(fields: [taxClassId], references: [id], onDelete: SetNull)

  tenant                 Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants               CatalogProductVariant[]
  supplierProducts       SupplierProduct[]
  media                  CatalogProductMedia[]
  sizeGuides             CatalogSizeGuide[]
  socialAds              MarketingSocialAd[]
  shareableSocialLinks   MarketingShareableLink[]
  reviews                ProductReview[]
  salesStats             AnalyticsProductSales[]
  collectionItems        CatalogCollectionItem[]
  storefrontSectionItems StorefrontSectionItem[]

  @@unique([tenantId, slug])
  @@index([categoryId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, featured])
  @@index([tenantId, deletedAt])
  @@index([taxClassId])
  @@index([tenantId, createdAt])
  @@map("catalog_products")
}

enum ProductStatus {
  DRAFT
  READY
  PUBLISHED
  ARCHIVED
}

enum ProductVisibility {
  PUBLIC
  PRIVATE
  HIDDEN
  MEMBERS_ONLY
}

model CatalogProductVariant {
  id              String    @id @default(uuid())
  tenantId        String
  productId       String
  sku             String?
  title           String
  price           Decimal   @db.Decimal(18, 2) // Actual selling price
  compareAtPrice  Decimal?  @db.Decimal(18, 2) // Crossed-out original price
  baseCost        Decimal?  @db.Decimal(18, 2) // Supplier cost
  sellingPrice    Decimal?  @db.Decimal(18, 2) // Configured selling price
  calculatedPrice Decimal?  @db.Decimal(18, 2) // Price after automated markup rule
  discount        Json? // Structured discount details
  stock           Int       @default(0)
  version         Int       @default(1) // Optimistic concurrency version
  deletedAt       DateTime?
  attributes      Json? // e.g. { color: "red", size: "XL" }

  sizeEntryId   String? // null = no size chart row linked yet
  pricingRuleId String? // Optional pricing/markup rule override for this variant

  tenant                Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product               CatalogProduct            @relation(fields: [productId], references: [id])
  sizeEntry             CatalogSizeEntry?         @relation(fields: [sizeEntryId], references: [id], onDelete: SetNull)
  pricingRule           CatalogPricingRule?       @relation("VariantPricingRules", fields: [pricingRuleId], references: [id], onDelete: SetNull)
  supplierVariants      SupplierVariant[]
  orderItems            CommerceOrderItem[]
  cartItems             CommerceCartItem[]
  media                 CatalogProductMedia[]
  inventoryTransactions InventoryTransaction[]
  wishlistItems         WishlistItem[]
  salesStats            AnalyticsProductSales[]
  collectionItems       CatalogCollectionItem[]
  variantAttributes     CatalogVariantAttribute[]
  inventoryStocks       InventoryStock[]

  @@unique([tenantId, sku])
  @@index([productId])
  @@index([tenantId])
  @@index([sizeEntryId])
  @@index([pricingRuleId])
  @@index([tenantId, deletedAt])
  @@map("catalog_product_variants")
}

model CatalogProductMedia {
  id               String    @id @default(uuid())
  productId        String
  productVariantId String?
  fileId           String?
  url              String
  type             MediaType @default(IMAGE)
  altText          String?
  position         Int       @default(0)
  isPrimary        Boolean   @default(false)
  createdAt        DateTime  @default(now())

  product        CatalogProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant CatalogProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  file           AuthFile?              @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([productVariantId])
  @@index([fileId])
  @@map("catalog_product_media")
}

enum MediaType {
  IMAGE
  GIF
  VIDEO
  AUDIO
  DOCUMENT
  ARCHIVE
  OTHER
}

/// A size chart / size guide for a product.
/// Works across any vertical:
///   - Fashion: Chest / Waist / Hips / Inseam / Length (CM or INCH)
///   - Electronics: Screen Size / Dimensions (MM or INCH)
///   - Furniture: Width / Height / Depth (CM or MM)
///   - Footwear: Foot Length mapped to US / EU / UK / JP sizes
model CatalogSizeGuide {
  id          String   @id @default(uuid())
  productId   String
  label       String // e.g. "International Size Chart", "EU Shoe Sizing"
  description String? // Optional help text shown below the chart
  unit        String   @default("CM") // "CM" | "MM" | "INCH" | "US" | "EU" | "UK" | "JP"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product CatalogProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  entries CatalogSizeEntry[]

  @@index([productId])
  @@map("catalog_size_guides")
}

/// A single row in a size chart.
/// Each row represents one size label and its corresponding measurements.
model CatalogSizeEntry {
  id        String @id @default(uuid())
  guideId   String
  sizeLabel String // e.g. "XS", "S", "M", "L", "XL", "42", "EU 38"
  position  Int    @default(0) // Sort order within the chart

  // Measurement columns — all optional; only populate what applies to the product
  chest      Decimal? @db.Decimal(12, 2) // Apparel upper body
  waist      Decimal? @db.Decimal(12, 2) // Apparel / bottoms
  hips       Decimal? @db.Decimal(12, 2) // Apparel lower body
  inseam     Decimal? @db.Decimal(12, 2) // Pants / trousers
  length     Decimal? @db.Decimal(12, 2) // Dress / jacket length
  shoulder   Decimal? @db.Decimal(12, 2) // Shoulder width
  sleeve     Decimal? @db.Decimal(12, 2) // Sleeve length
  footLength Decimal? @db.Decimal(12, 2) // Footwear
  width      Decimal? @db.Decimal(12, 2) // Product width (furniture, electronics)
  height     Decimal? @db.Decimal(12, 2) // Product height
  depth      Decimal? @db.Decimal(12, 2) // Product depth
  screenSize Decimal? @db.Decimal(12, 2) // Electronics (diagonal inches)
  weight     Decimal? @db.Decimal(12, 2) // Weight of the product at this size
  weightUnit String? // "KG" | "LB" | "G" | "OZ"

  guide    CatalogSizeGuide        @relation(fields: [guideId], references: [id], onDelete: Cascade)
  variants CatalogProductVariant[] // All variants that reference this size row

  @@index([guideId, position])
  @@map("catalog_size_entries")
}

// ==============================================================================
// 4. MULTI-SUPPLIER DROPSHIPPING SCHEMA
// ==============================================================================

model SupplierPartner {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. "cj-dropshipping", "aliexpress", "zendrop"
  displayName String
  isActive    Boolean  @default(true)
  config      Json? // API keys, base URLs, rate limits
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  credentials SupplierCredential[]
  products    SupplierProduct[]
  orders      CommerceSupplierOrder[]
  syncLogs    SupplierSyncLog[]
  syncJobs    SupplierSyncJob[]
  statistics  AnalyticsSupplier[]

  @@map("supplier_partners")
}

model SupplierCredential {
  id          String    @id @default(uuid())
  supplierId  String
  environment String    @default("production") // e.g. "sandbox", "production"
  apiKey      String?
  apiSecret   String?
  accessToken String?
  expiresAt   DateTime?
  config      Json?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  supplier SupplierPartner @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_credentials")
}

model SupplierSyncLog {
  id               String     @id @default(uuid())
  supplierId       String
  action           String // e.g. "SYNC_PRODUCTS", "SYNC_ORDERS"
  status           SyncStatus @default(PENDING)
  recordsProcessed Int        @default(0)
  details          Json?
  errorMessage     String?
  startedAt        DateTime   @default(now())
  completedAt      DateTime?

  supplier SupplierPartner @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_sync_logs")
}

model SupplierProduct {
  id          String  @id @default(uuid())
  supplierId  String
  productId   String? // null = not yet mapped to catalog
  externalId  String // Supplier's own product ID
  externalSku String?

  // Extracted / denormalised from rawData for easy display without JSON parsing
  title        String? // Product name as given by supplier
  description  String? // Product description from supplier
  brand        String? // Brand name
  thumbnailUrl String? // Primary image URL (convenience — mirrors first isPrimary image)

  rawData          Json // Full supplier response (source of truth)
  costPrice        Decimal    @db.Decimal(12, 2) // Wholesale supplier cost
  retailPrice      Decimal?   @db.Decimal(12, 2) // Recommended MSRP / compare-at price from supplier
  shippingEstimate Decimal?   @db.Decimal(12, 2)
  syncStatus       SyncStatus @default(PENDING)
  lastSyncError    String?
  lastSyncedAt     DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  supplier SupplierPartner        @relation(fields: [supplierId], references: [id])
  product  CatalogProduct?        @relation(fields: [productId], references: [id])
  variants SupplierVariant[]
  images   SupplierProductImage[]

  @@unique([supplierId, externalId])
  @@index([supplierId])
  @@index([productId])
  @@map("supplier_products")
}

model SupplierVariant {
  id                String     @id @default(uuid())
  supplierProductId String
  productVariantId  String? // null = not yet mapped
  externalId        String
  costPrice         Decimal    @db.Decimal(12, 2) // Wholesale supplier cost
  retailPrice       Decimal?   @db.Decimal(12, 2) // Recommended MSRP / compare-at price for this variant
  rawData           Json
  stock             Int?
  syncStatus        SyncStatus @default(PENDING)
  lastSyncError     String?
  lastSyncedAt      DateTime?

  // Extracted / denormalised from rawData for easy display
  title        String? // Variant name/label (e.g. "Red / XL")
  thumbnailUrl String? // Primary image (convenience — mirrors first isPrimary image)
  attributes   Json? // e.g. { color: "Red", size: "XL" }

  supplierProduct SupplierProduct        @relation(fields: [supplierProductId], references: [id])
  productVariant  CatalogProductVariant? @relation(fields: [productVariantId], references: [id])
  images          SupplierVariantImage[]

  @@unique([supplierProductId, externalId])
  @@map("supplier_variants")
}

/// One image belonging to a supplier product.
/// Mirrors CatalogProductMedia but lives on the supplier side,
/// so we can show images before a product is mapped into the catalog.
model SupplierProductImage {
  id                String   @id @default(uuid())
  supplierProductId String
  fileId            String? // Optional direct link to uploaded AuthFile
  url               String // Full image URL from supplier
  thumbnailUrl      String? // Resized/compressed thumbnail if available
  altText           String? // Accessibility / SEO alt text
  position          Int      @default(0) // Display order (0 = first)
  isPrimary         Boolean  @default(false) // True for the hero/cover image
  type              String   @default("IMAGE") // "IMAGE" | "VIDEO" | "GIF"
  createdAt         DateTime @default(now())

  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  file            AuthFile?       @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([supplierProductId, position])
  @@index([supplierProductId, isPrimary])
  @@index([fileId])
  @@map("supplier_product_images")
}

/// One image belonging to a supplier variant (e.g. each colour swatch has its own photo).
/// Mirrors SupplierProductImage but scoped to a specific variant.
model SupplierVariantImage {
  id                String   @id @default(uuid())
  supplierVariantId String
  fileId            String? // Optional direct link to uploaded AuthFile
  url               String // Full image URL from supplier
  thumbnailUrl      String? // Resized/compressed thumbnail if available
  altText           String? // Accessibility / SEO alt text
  position          Int      @default(0) // Display order (0 = first)
  isPrimary         Boolean  @default(false) // True for the hero image of this variant
  type              String   @default("IMAGE") // "IMAGE" | "VIDEO" | "GIF"
  createdAt         DateTime @default(now())

  supplierVariant SupplierVariant @relation(fields: [supplierVariantId], references: [id], onDelete: Cascade)
  file            AuthFile?       @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([supplierVariantId, position])
  @@index([supplierVariantId, isPrimary])
  @@index([fileId])
  @@map("supplier_variant_images")
}

// ==============================================================================
// 5. COMMERCE: CUSTOMERS, CARTS & SHIPPING
// ==============================================================================

model CommerceCustomer {
  id        String   @id @default(uuid())
  userId    String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       AuthUser                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses  CommerceShippingAddress[]
  carts      CommerceCart[]
  orders     CommerceOrder[]
  reviews    ProductReview[]
  wishlists  Wishlist[]
  returns    Return[]
  statistics AnalyticsCustomer[]

  @@map("commerce_customers")
}

model CommerceShippingAddress {
  id           String   @id @default(uuid())
  customerId   String
  fullName     String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String
  country      String
  phone        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer CommerceCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders   CommerceOrder[]

  @@index([customerId])
  @@map("commerce_shipping_addresses")
}

model CommerceCart {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String?
  sessionId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer CommerceCustomer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CommerceCartItem[]

  @@unique([tenantId, customerId])
  @@unique([tenantId, sessionId])
  @@index([customerId])
  @@index([tenantId])
  @@map("commerce_carts")
}

model CommerceCartItem {
  id               String   @id @default(uuid())
  cartId           String
  productVariantId String
  quantity         Int      @default(1)
  unitPrice        Decimal
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cart           CommerceCart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant CatalogProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([cartId, productVariantId])
  @@map("commerce_cart_items")
}

// ==============================================================================
// 6. COMMERCE: ORDERS, PAYMENTS & FULFILLMENT
// ==============================================================================

model CommerceOrder {
  id                String      @id @default(uuid())
  tenantId          String
  status            OrderStatus @default(PENDING)
  totalAmount       Decimal     @db.Decimal(12, 2)
  discountAmount    Decimal     @default(0) @db.Decimal(12, 2)
  currency          String      @default("USD")
  customerId        String?
  sessionId         String?
  shippingAddressId String?
  couponId          String?
  promotionId       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  customer        CommerceCustomer?        @relation(fields: [customerId], references: [id])
  shippingAddress CommerceShippingAddress? @relation(fields: [shippingAddressId], references: [id])
  coupon          Coupon?                  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  promotion       Promotion?               @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  items           CommerceOrderItem[]
  supplierOrders  CommerceSupplierOrder[] // 1 order -> N supplier fulfillments
  payments        CommercePayment[]
  returns         Return[]
  refunds         Refund[]

  @@index([tenantId])
  @@index([customerId])
  @@index([shippingAddressId])
  @@index([couponId])
  @@index([promotionId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("commerce_orders")
}

model CommerceOrderItem {
  id               String  @id @default(uuid())
  orderId          String
  productVariantId String
  quantity         Int
  unitPrice        Decimal @db.Decimal(18, 2)
  supplierOrderId  String?

  // Immutable historical order snapshot fields
  productTitle String  @default("Unknown Product")
  variantTitle String?
  sku          String?
  imageUrl     String?
  attributes   Json?

  order          CommerceOrder          @relation(fields: [orderId], references: [id])
  productVariant CatalogProductVariant  @relation(fields: [productVariantId], references: [id])
  supplierOrder  CommerceSupplierOrder? @relation(fields: [supplierOrderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productVariantId])
  @@index([supplierOrderId])
  @@map("commerce_order_items")
}

model CommerceSupplierOrder {
  id          String              @id @default(uuid())
  orderId     String
  supplierId  String
  externalId  String? // Supplier's order ID after placement
  status      SupplierOrderStatus @default(PENDING)
  rawResponse Json? // Full supplier order response
  trackingNum String?
  placedAt    DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  order     CommerceOrder       @relation(fields: [orderId], references: [id])
  supplier  SupplierPartner     @relation(fields: [supplierId], references: [id])
  shipments CommerceShipment[]
  items     CommerceOrderItem[]

  @@index([orderId])
  @@index([supplierId])
  @@map("commerce_supplier_orders")
}

model CommerceShipment {
  id                String         @id @default(uuid())
  supplierOrderId   String
  trackingNumber    String?
  carrier           String?
  status            ShipmentStatus @default(PENDING)
  shippedAt         DateTime?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  details           Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  supplierOrder CommerceSupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)

  @@index([supplierOrderId])
  @@map("commerce_shipments")
}

model CommercePayment {
  id                   String             @id @default(uuid())
  orderId              String
  gateway              PaymentGateway? // Must be set explicitly by the merchant
  channel              PaymentChannel? // Must be set explicitly by the merchant
  instrument           PaymentInstrument?
  expectedAmount       Decimal            @db.Decimal(18, 2)
