// ==============================================================================
// 14. DYNAMIC CATALOG COLLECTION & LOOKBOOK SCHEMA
//     Supports any vertical: Fashion Outfits, Electronics Setups,
//     Beauty Routines, Home Room Bundles, etc.
// ==============================================================================

enum CollectionType {
  OUTFIT
  LOOKBOOK
  BUNDLE
  ROUTINE
  SETUP
  ROOM_BUNDLE
}

/// A curated grouping of products — universal across all storefront verticals.
/// type examples: \"OUTFIT\", \"SETUP\", \"ROUTINE\", \"BUNDLE\", \"LOOKBOOK\", \"ROOM_BUNDLE\"
/// slot examples: \"UpperGarment\", \"Monitor\", \"Cleanser\", \"Sofa\", \"Supplement\"
///
/// Collections can be nested: a parent LOOKBOOK can contain child collections
/// of any type (e.g. a Fashion OUTFIT + a Beauty ROUTINE together).
/// Admin decides what to combine — no hard-coded vertical constraints.
model CatalogCollection {
  id          String         @id @default(uuid())
  tenantId    String
  title       String
  slug        String
  description String?
  type        CollectionType
  sortOrder   Int            @default(0)
  imageFileId String? // Optional direct link to uploaded AuthFile
  imageUrl    String? // Hero/render image for the complete collection
  metadata    Json? // Vertical-specific params: { climate, style, roomType, season, etc. }
  isPublic    Boolean        @default(true)
  isDeleted   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Self-referential nesting: a LOOKBOOK parent can hold OUTFIT + ROUTINE children
  parentId String? // null = top-level collection; set = sub-collection of a parent

  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent             CatalogCollection?      @relation("CollectionHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children           CatalogCollection[]     @relation("CollectionHierarchy")
  items              CatalogCollectionItem[]
  pageSections       CmsPageSection[]
  imageFile          AuthFile?               @relation("CollectionImageFile", fields: [imageFileId], references: [id], onDelete: SetNull)
  storefrontSections StorefrontSection[]

  @@unique([tenantId, slug])
  @@index([tenantId, type])
  @@index([tenantId, isPublic])
  @@index([parentId])
  @@index([imageFileId])
  @@map("catalog_collections")
}

/// A single product slot within a CatalogCollection.
/// position = display/layer order (0 = back, higher = front for fashion; 0 = primary for bundles).
/// Every item MUST link to a product — clicking it on the storefront navigates to that product page.
/// productVariantId is optional: when null, the frontend shows the product's default/primary variant.
model CatalogCollectionItem {
  id               String   @id @default(uuid())
  collectionId     String
  productId        String // Required — every slot must point to a catalog product
  productVariantId String? // Optional — null = show product's default variant
  imageFileId      String? // Optional direct link to uploaded AuthFile
  slot             String? // e.g. "UpperGarment", "Monitor", "Cleanser", "Sofa"
  imageUrl         String? // Override image for this item's slot (falls back to product thumbnailUrl)
  position         Int      @default(0)
  isOptional       Boolean  @default(false) // whether the item is required or optional in the set
  metadata         Json? // e.g. { colorSwatch, sizeGuide, note }
  createdAt        DateTime @default(now())

  collection     CatalogCollection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product        CatalogProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant CatalogProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  imageFile      AuthFile?              @relation("CollectionItemImageFile", fields: [imageFileId], references: [id], onDelete: SetNull)

  @@index([collectionId, position])
  @@index([productId])
  @@index([productVariantId])
  @@index([imageFileId])
  @@map("catalog_collection_items")
}

// ==============================================================================
// 15. PLATFORM ENGINE: EAV ATTRIBUTES, PROMOTIONS & MULTI-LOCATION INVENTORY
// ==============================================================================

enum AttributeType {
  SELECT
  TEXT
  NUMBER
  BOOLEAN
}

/// Tenant-scoped attribute definition (e.g. "Color", "RAM", "Size", "Material", "Volume").
model CatalogAttribute {
  id           String        @id @default(uuid())
  tenantId     String
  name         String // Display name e.g. "Color"
  code         String // Machine slug e.g. "color"
  type         AttributeType @default(SELECT)
  isFilterable Boolean       @default(true)
  isSearchable Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values CatalogAttributeValue[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("catalog_attributes")
}

/// Dynamic value option for an attribute (e.g. "Red", "16GB", "Extra Large").
model CatalogAttributeValue {
  id          String   @id @default(uuid())
  attributeId String
  value       String // Normalized value e.g. "red", "16gb"
  label       String // Human label e.g. "Crimson Red"
  swatchColor String? // Optional hex color swatch e.g. "#FF0000"
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  attribute CatalogAttribute          @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants  CatalogVariantAttribute[]

  @@unique([attributeId, value])
  @@index([attributeId])
  @@map("catalog_attribute_values")
}

/// Join table connecting CatalogProductVariant to CatalogAttributeValue.
model CatalogVariantAttribute {
  variantId String
  valueId   String

  variant CatalogProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  value   CatalogAttributeValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([variantId, valueId])
  @@index([variantId])
  @@index([valueId])
  @@map("catalog_variant_attributes")
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  SCHEDULED
  EXPIRED
  DISABLED
}

/// Decoupled promotion rule engine root for campaigns, coupons, and discounts.
model Promotion {
  id          String          @id @default(uuid())
  tenantId    String
  title       String
  code        String? // Optional promo coupon code (e.g. "SUMMER20")
  description String?
  status      PromotionStatus @default(ACTIVE)
  priority    Int             @default(0)
  startDate   DateTime?
  endDate     DateTime?
  usageLimit  Int?
  usageCount  Int             @default(0)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rules   PromotionRule[]
  rewards PromotionReward[]
  targets PromotionTarget[]
  orders  CommerceOrder[]

  @@index([tenantId, status])
  @@index([code])
  @@index([tenantId, deletedAt])
  @@map("promotions")
}

/// Qualification condition for a promotion.
model PromotionRule {
  id          String   @id @default(uuid())
  promotionId String
  ruleType    String // "MIN_CART_TOTAL" | "MIN_QUANTITY" | "CUSTOMER_GROUP" | "FIRST_ORDER"
  condition   Json // e.g. { minTotal: 100, currency: "USD" }
  createdAt   DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@map("promotion_rules")
}

/// Payout / reward definition for a promotion.
model PromotionReward {
  id          String   @id @default(uuid())
  promotionId String
  rewardType  String // "PERCENTAGE_OFF" | "FIXED_AMOUNT_OFF" | "FREE_SHIPPING" | "BUY_X_GET_Y"
  value       Decimal  @db.Decimal(12, 2)
  maxDiscount Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@map("promotion_rewards")
}

/// Target scope for a promotion (Products, Variants, Collections, Categories).
model PromotionTarget {
  id          String   @id @default(uuid())
  promotionId String
  targetType  String // "ALL" | "PRODUCT" | "VARIANT" | "COLLECTION" | "CATEGORY"
  targetId    String? // ID of product, variant, collection, or category
  createdAt   DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId, targetType, targetId])
  @@map("promotion_targets")
}

/// Physical or virtual stock location (Warehouse, Retail Store, Supplier Hub).
model InventoryLocation {
  id        String   @id @default(uuid())
  tenantId  String
  name      String // e.g. "Main Warehouse", "Downtown Store"
  code      String // e.g. "WH-MAIN-01"
  type      String // "WAREHOUSE" | "RETAIL_STORE" | "SUPPLIER_HUB" | "VIRTUAL"
  isPrimary Boolean  @default(false)
  isActive  Boolean  @default(true)
  address   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stocks InventoryStock[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("inventory_locations")
}

/// Multi-location inventory stock count per variant & location.
model InventoryStock {
  id           String   @id @default(uuid())
  tenantId     String
  variantId    String
  locationId   String
  onHand       Int      @default(0) // Physical count in warehouse
  reserved     Int      @default(0) // Locked in active checkouts/pending orders
  available    Int      @default(0) // Computed / stored (onHand - reserved)
  reorderPoint Int      @default(5)
  version      Int      @default(1) // Optimistic concurrency version
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant  CatalogProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location InventoryLocation     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([variantId, locationId])
  @@index([tenantId])
  @@index([variantId])
  @@index([locationId])
  @@map("inventory_stocks")
}

// ==============================================================================
// 16. TAX ENGINE & JURISDICTIONS
// ==============================================================================

model TaxClass {
  id          String   @id @default(uuid())
  tenantId    String
  name        String // e.g. "Standard Goods", "Reduced VAT", "Digital Services"
  code        String // e.g. "STANDARD", "REDUCED", "ZERO"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rates    TaxRate[]
  products CatalogProduct[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("tax_classes")
}

model TaxRate {
  id         String   @id @default(uuid())
  tenantId   String
  taxClassId String?
  name       String // e.g. "VAT 12%", "California Sales Tax"
  rate       Decimal  @db.Decimal(5, 4) // e.g. 0.1200 for 12%
  country    String // ISO 2-letter country code e.g. "PH", "US"
  state      String? // State / province code e.g. "CA", "NY"
  postalCode String?
  isCombined Boolean  @default(false)
  priority   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxClass TaxClass? @relation(fields: [taxClassId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([taxClassId])
  @@index([tenantId, country, state])
  @@map("tax_rates")
}

model SupplierSyncJob {
  id           String     @id @default(uuid())
  tenantId     String
  supplierId   String
  action       String // "SYNC_PRODUCTS" | "SYNC_INVENTORY" | "SYNC_ORDERS"
  status       SyncStatus @default(PENDING)
  priority     Int        @default(0)
  retries      Int        @default(0)
  maxRetries   Int        @default(3)
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  lockOwner    String?
  payload      Json?
  errorMessage String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier SupplierPartner @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([supplierId])
  @@index([scheduledAt])
  @@map("supplier_sync_jobs")
}

// ==============================================================================
// 19. STOREFRONT MERCHANDISING SCHEMA
// ==============================================================================

/// Which type of page this is.
enum StorefrontPageType {
  HOME
  CATEGORY
  PRODUCT
  STORE
  BRAND
  SEARCH
  CAMPAIGN
  CUSTOM
}

enum StorefrontContextType {
  CATEGORY
  STORE
  BRAND
  CAMPAIGN
}

/// How the section is populated — this drives the strategy selected at runtime.
enum StorefrontSectionStrategy {
  MANUAL
  COLLECTION
  TRENDING
  BEST_SELLERS
  NEW_ARRIVALS
  FLASH_SALE
  FEATURED
  RECOMMENDED
}

model StorefrontPage {
  id       String @id @default(uuid())
  tenantId String

  title    String
  slug     String
  pageType StorefrontPageType

  isPublished Boolean @default(true)

  seoTitle       String?
  seoDescription String?
  layout         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  sections StorefrontSection[]

  @@unique([tenantId, slug])
  @@index([tenantId, pageType])
  @@index([tenantId, isPublished])
  @@map("storefront_pages")
}

model StorefrontSection {
  id       String @id @default(uuid())
  tenantId String

  title String
  slug  String

  pageId   String
  strategy StorefrontSectionStrategy

  sortOrder    Int  @default(0)
  maxItems     Int  @default(20)
  cacheMinutes Int?

  isEnabled Boolean @default(true)

  /// Strategy-specific parameters (e.g. recommendation thresholds, algorithm options).
  config Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Bridge to a curated CatalogCollection (used when strategy = COLLECTION).
  collectionId String?

  /// Polymorphic Context Target
  contextType StorefrontContextType?
  contextId   String?

  tenant      Tenant                  @relation(fields: [tenantId], references: [id])
  page        StorefrontPage          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  collection  CatalogCollection?      @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  pinnedItems StorefrontSectionItem[]

  @@unique([tenantId, slug])
  @@index([pageId])
  @@index([tenantId, strategy])
  @@index([tenantId, isEnabled])
  @@index([collectionId])
  @@index([contextType, contextId])
  @@map("storefront_sections")
}

model StorefrontSectionItem {
  id String @id @default(uuid())

  sectionId String
  productId String

  position Int

  section StorefrontSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product CatalogProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sectionId, productId])
  @@index([sectionId, position])
  @@index([productId])
  @@map("storefront_section_items")
}
