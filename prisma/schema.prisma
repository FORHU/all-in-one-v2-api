generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// User & Auth Schema
// ==========================================

model User {
  id                  String                 @id @default(uuid())
  email               String                 @unique
  password            String? // Optional for social-only users
  name                String?
  username            String                 @unique
  role                UserRole               @default(USER)
  isActive            Boolean                @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  avatarId            String?
  isDeleted           Boolean                @default(false)
  isEmailVerified     Boolean                @default(true)
  onboardingCompleted Boolean                @default(false)
  avatar              File?                  @relation("UserAvatar", fields: [avatarId], references: [id])
  sessions            Session[]
  socialAccounts      SessionSocialAccount[]
  customer            Customer?
  auditLogs           AuditLog[]
}

model Session {
  id                String   @id @default(uuid())
  userId            String
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  refreshToken      String   @unique
  provider          String?
  providerAvatarUrl String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SessionSocialAccount {
  id             String    @id @default(uuid())
  userId         String
  platform       String
  providerUserId String
  accessToken    String
  refreshToken   String?
  expiresAt      DateTime?
  scopes         String?
  avatarUrl      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id])

  @@unique([userId, platform])
}

model File {
  id        String    @id @default(uuid())
  filename  String?
  fileUrl   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  metaData  Json?
  users     User[]    @relation("UserAvatar")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
  DEVELOPER
}

// ==========================================
// Tenants (Verticals)
// ==========================================

/// A storefront vertical — e.g. "fashion", "beauty", "sports". Each one gets
/// its own subdomain, catalog and CMS content, but shares the platform's users,
/// customers and supplier integrations.
model Tenant {
  id        String       @id @default(uuid())
  slug      String       @unique // subdomain: fashion -> fashion.example.com
  name      String
  domain    String?      @unique // optional custom domain
  status    TenantStatus @default(ACTIVE)
  settings  Json? // theme, logo, contact details
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// ==========================================
// Category & Product Catalog Schema
// ==========================================

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
}

model Product {
  id          String        @id @default(uuid())
  title       String
  slug        String?       @unique
  description String?
  tags        String[]
  status      ProductStatus @default(DRAFT)
  featured    Boolean       @default(false)
  salePrice   Decimal?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  pricingRuleId String?
  pricingRule   PricingRule? @relation(fields: [pricingRuleId], references: [id])

  variants         ProductVariant[]
  supplierProducts SupplierProduct[]
  images           ProductImage[]

  @@index([categoryId])
}

enum ProductStatus {
  DRAFT
  READY
  PUBLISHED
  ARCHIVED
}

model ProductVariant {
  id              String   @id @default(uuid())
  productId       String
  sku             String?  @unique
  title           String
  price           Decimal // Legacy / main display price
  baseCost        Decimal? // Supplier cost
  sellingPrice    Decimal? // Configured selling price
  calculatedPrice Decimal? // Price after automated pricing rule markup
  stock           Int      @default(0)
  attributes      Json? // e.g. { color: "red", size: "XL" }

  product          Product           @relation(fields: [productId], references: [id])
  supplierVariants SupplierVariant[]
  orderItems       OrderItem[]
  cartItems        CartItem[]
  images           ProductImage[]

  @@index([productId])
}

model ProductImage {
  id               String   @id @default(uuid())
  productId        String
  productVariantId String?
  url              String
  altText          String?
  position         Int      @default(0)
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now())

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([productVariantId])
}

// ==========================================
// Multi-Supplier Dropshipping Schema
// ==========================================

model Supplier {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. "cj-dropshipping", "aliexpress", "zendrop"
  displayName String
  isActive    Boolean  @default(true)
  config      Json? // API keys, base URLs, rate limits
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  credentials SupplierCredential[]
  products    SupplierProduct[]
  orders      SupplierOrder[]
  syncLogs    SupplierSyncLog[]
}

model SupplierCredential {
  id          String    @id @default(uuid())
  supplierId  String
  environment String    @default("production") // e.g. "sandbox", "production"
  apiKey      String?
  apiSecret   String?
  accessToken String?
  expiresAt   DateTime?
  config      Json?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model SupplierSyncLog {
  id               String     @id @default(uuid())
  supplierId       String
  action           String // e.g. "SYNC_PRODUCTS", "SYNC_ORDERS"
  status           SyncStatus @default(PENDING)
  recordsProcessed Int        @default(0)
  details          Json?
  errorMessage     String?
  startedAt        DateTime   @default(now())
  completedAt      DateTime?

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model SupplierProduct {
  id               String     @id @default(uuid())
  supplierId       String
  productId        String? // null = not yet mapped to catalog
  externalId       String // Supplier's own product ID
  externalSku      String?
  rawData          Json // Full supplier response
  costPrice        Decimal
  shippingEstimate Decimal?
  syncStatus       SyncStatus @default(PENDING)
  lastSyncError    String?
  lastSyncedAt     DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  supplier Supplier          @relation(fields: [supplierId], references: [id])
  product  Product?          @relation(fields: [productId], references: [id])
  variants SupplierVariant[]

  @@unique([supplierId, externalId])
  @@index([supplierId])
  @@index([productId])
}

model SupplierVariant {
  id                String     @id @default(uuid())
  supplierProductId String
  productVariantId  String? // null = not yet mapped
  externalId        String
  costPrice         Decimal
  rawData           Json
  stock             Int?
  syncStatus        SyncStatus @default(PENDING)
  lastSyncError     String?
  lastSyncedAt      DateTime?

  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id])
  productVariant  ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@unique([supplierProductId, externalId])
}

// ==========================================
// Commerce: Customer, Cart & Shipping Address
// ==========================================

model Customer {
  id        String   @id @default(uuid())
  userId    String?  @unique
  email     String   @unique
  firstName String?
  lastName  String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?             @relation(fields: [userId], references: [id])
  addresses ShippingAddress[]
  carts     Cart[]
  orders    Order[]
}

model ShippingAddress {
  id           String   @id @default(uuid())
  customerId   String?
  fullName     String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String
  country      String
  phone        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])
  orders   Order[]

  @@index([customerId])
}

model Cart {
  id         String   @id @default(uuid())
  customerId String?
  sessionId  String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id])
  items    CartItem[]

  @@index([customerId])
}

model CartItem {
  id               String   @id @default(uuid())
  cartId           String
  productVariantId String
  quantity         Int      @default(1)
  unitPrice        Decimal
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([cartId, productVariantId])
}

// ==========================================
// Commerce: Orders, Payments & Fulfillment
// ==========================================

model Order {
  id                String      @id @default(uuid())
  status            OrderStatus @default(PENDING)
  totalAmount       Decimal
  currency          String      @default("USD")
  customerId        String?
  /// Guest checkout identity, copied from the cart's session. Lets a guest
  /// pay for and track an order they placed without an account.
  sessionId         String?
  shippingAddressId String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  customer        Customer?        @relation(fields: [customerId], references: [id])
  shippingAddress ShippingAddress? @relation(fields: [shippingAddressId], references: [id])
  items           OrderItem[]
  supplierOrders  SupplierOrder[] // 1 order -> N supplier fulfillments
  payments        Payment[]

  @@index([customerId])
  @@index([sessionId])
  @@index([shippingAddressId])
}

model OrderItem {
  id               String  @id @default(uuid())
  orderId          String
  productVariantId String
  quantity         Int
  unitPrice        Decimal
  supplierOrderId  String?

  order          Order          @relation(fields: [orderId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  // Which supplier fulfillment this line was routed to. Null until the order
  // is split across suppliers.
  supplierOrder  SupplierOrder? @relation(fields: [supplierOrderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productVariantId])
  @@index([supplierOrderId])
}

model SupplierOrder {
  id          String              @id @default(uuid())
  orderId     String
  supplierId  String
  externalId  String? // Supplier's order ID after placement
  status      SupplierOrderStatus @default(PENDING)
  rawResponse Json? // Full supplier order response
  trackingNum String?
  placedAt    DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  order     Order       @relation(fields: [orderId], references: [id])
  supplier  Supplier    @relation(fields: [supplierId], references: [id])
  shipments Shipment[]
  items     OrderItem[]

  @@index([orderId])
  @@index([supplierId])
}

model Shipment {
  id                String         @id @default(uuid())
  supplierOrderId   String
  trackingNumber    String?
  carrier           String?
  status            ShipmentStatus @default(PENDING)
  shippedAt         DateTime?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  details           Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)

  @@index([supplierOrderId])
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  amount        Decimal
  currency      String        @default("PHP")
  provider      String // e.g. "PAYMONGO", "STRIPE", "PAYPAL"
  paymentMethod String? // e.g. "GCASH", "CARD", "GRAB_PAY"
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  rawPayload    Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model WebhookEvent {
  id           String     @id @default(uuid())
  provider     String // e.g. "PAYMONGO", "CJ_DROPSHIPPING"
  eventType    String
  payload      Json
  status       SyncStatus @default(PENDING)
  errorMessage String?
  processedAt  DateTime?
  createdAt    DateTime   @default(now())
}

enum OrderStatus {
  PENDING
  PROCESSING
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  REFUNDED
}

enum SupplierOrderStatus {
  PENDING
  PLACED
  CONFIRMED
  SHIPPED
  DELIVERED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

// ==========================================
// Background Jobs & Operations
// ==========================================

model Job {
  id          String    @id @default(uuid())
  type        String // e.g., 'PRODUCT_SYNC'
  content     String? // A friendly name/description
  status      JobStatus @default(PENDING)
  payload     Json? // Input parameters & progress tracking
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  logs JobLog[]
}

model JobLog {
  id        String   @id @default(uuid())
  jobId     String
  level     LogLevel @default(INFO)
  message   String
  details   Json?
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String // e.g. "UPDATE_PRICING_RULE", "DELETE_PRODUCT"
  entity    String // e.g. "Product", "User"
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PAUSED
  CANCELLED
}

enum LogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

// ==========================================
// Centralized Marketplace Additions
// ==========================================

model PricingRule {
  id            String     @id @default(uuid())
  name          String     @unique
  markupType    MarkupType
  markupValue   Decimal
  minimumProfit Decimal?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  products Product[]
}

enum MarkupType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum SyncStatus {
  PENDING
  SUCCESS
  FAILED
}

// ==========================================
// CMS (Content Management System) Models
// ==========================================

model Page {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  status      String   @default("DRAFT")
  seoMetadata Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections PageSection[]
}

model PageSection {
  id        String   @id @default(uuid())
  pageId    String
  type      String // e.g. "HERO", "FEATURE_GRID", "TESTIMONIALS"
  content   Json
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String
  linkUrl   String?
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(uuid())
  content   String
  linkUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
